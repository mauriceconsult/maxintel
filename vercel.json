{
  "framework":       null,
  "installCommand":  "bun install",
  "buildCommand":    "bun run build:packages && bun run --filter @maxintel/database db:deploy",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  }
}
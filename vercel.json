{
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run build:packages",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    },
    "packages/server/**": {
      "includeFiles": "../database/generated/prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
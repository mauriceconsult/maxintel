{
  "name": "maxintel",
  "version": "1.0.0",
  "workspaces": ["packages/*"],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.19.43",
    "bun": "^1.3.14",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "@types/node": "^20"
  },

  "scripts": {
    "build:shared": "bun run --cwd packages/shared build",
    "build:database": "bun run --cwd packages/database build",
    "build:server": "bun run --cwd packages/server build",
    "build:cli": "bun run --cwd packages/cli build",

    "build":
      "bun run --cwd packages/shared build && bun run --cwd packages/database build && bun run --cwd packages/server build && bun run --cwd packages/cli build"
  },

  "dependencies": {
    "@ai-sdk/google": "^4.0.16",
    "hono": "^4.12.29"
  }
}
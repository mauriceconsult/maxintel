{
  "name": "maxintel",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run --hot packages/server/src/index.ts",
    "build:shared": "bun run --filter @maxintel/shared build",
    "build:database": "bun run --filter @maxintel/database build",
    "build:packages": "bun run build:shared && bun run build:database && bun run build:server",
    "build:server": "bun run --filter @maxintel/server build",
    "build:app": "bun run build:server",
    "build:cli": "bun run --filter @maxintel/cli build",
    "build": "bun run build:packages && bun run build:app",
    "link:cli": "bun run build:cli && cd packages/cli && bun link",
    "type-check": "bun run build:packages && bunx tsc -b",
    "dev": "bun packages/server/src/index.ts",
    "start": "bun packages/server/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentui/core-win32-x64": "0.4.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.19.43",
    "@vercel/node": "^7.0.0",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.45",
    "@ai-sdk/deepseek": "^3.0.36",
    "@ai-sdk/google": "^4.0.57",
    "@ai-sdk/openai": "^4.0.51",
    "@ai-sdk/xai": "^4.0.49",
    "@clerk/hono": "^0.1.73",
    "@hono/node-server": "^1.13.7",
    "@sentry/node": "^10.71.0",
    "ai": "^7.0.84",
    "dotenv": "^17.4.2",
    "hono": "^4.13.3"
  },
  "overrides": {
    "hono": "4.13.3",
    "ai": "7.0.84",
    "@ai-sdk/provider": "4.0.8",
    "@ai-sdk/provider-utils": "5.0.33"
  }
}

{
  "name": "maxintel",
  "version": "1.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run --hot packages/server/src/index.ts",
    "build:shared": "bun run --filter @maxintel/shared build",
    "build:database": "bun run --filter @maxintel/database build",
    "build:packages": "bun run build:shared && bun run build:database",
    "build:server": "bun run --filter @maxintel/server build",
    "build:app": "bun run build:server",
    "build": "bun run build:packages && bun run build:app",
    "type-check": "bunx tsc --noEmit",
    "dev": "bun packages/server/src/index.ts",
    "start": "bun packages/server/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.19.43",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },

  "dependencies": {
    "hono": "4.13.3"
  },
  "overrides": {
    "hono": "4.13.3"
  }
}

{
  "name": "maxintel",
  "version": "1.0.0",
  "workspaces": ["packages/*"],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.19.43",
    "bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "@types/node": "^20"
  },
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run --hot packages/server/src/index.ts",
    "build:shared": "cd packages/shared && bun run build",
    "build:database": "cd packages/database && bun run build",
    "build:packages": "bun run build:shared && bun run build:database",

    "type-check": "bun run build:packages && bunx tsc --noEmit",
    "build:app": "echo 'Hono server ready'",
    "build": "bun run build:packages && bun run build:app",

    "dev": "bun src/index.ts",
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.16",
    "hono": "^4.12.29"
  }
}
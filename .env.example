# ── Browser MoMo checkout ────────────────────────────────────────────────────
# HMAC secret that signs /billing/checkout links. Required in production —
# without it links are signed with a per-process key and break on restart.
CHECKOUT_TOKEN_SECRET=
# Public origin used to build absolute checkout links (falls back to
# MOMO_CALLBACK_HOST, then https://maxintel.maxnovate.com).
PUBLIC_BASE_URL=

# ── MTN MoMo collections ─────────────────────────────────────────────────────
MOMO_PRIMARY_KEY=
MOMOUSER_ID=
MOMOUSER_SECRET=
MOMO_TARGET_ENVIRONMENT=
# sandbox | mtnuganda | mtncongo — sent as X-Target-Environment
MOMO_ENV=sandbox
MOMO_CALLBACK_HOST=
# Optional overrides for a non-Uganda deployment
MOMO_CURRENCY=UGX
MOMO_COUNTRY_CODE=256
MOMO_PHONE_PLACEHOLDER=0772 123 456

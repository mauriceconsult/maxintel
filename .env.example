# Server
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Add the provider keys for the models you want to make available
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional server configuration
SENTRY_DSN=
PLATFORM_ADMIN_KEY=
PLATFORM_DEFAULT_MODEL=

# CLI
API_URL=http://localhost:3000
CLERK_FRONTEND_API=
CLERK_OAUTH_CLIENT_ID=

# Optional browser checkout configuration
# Required for stable checkout links across restarts and serverless instances.
CHECKOUT_TOKEN_SECRET=
PUBLIC_BASE_URL=http://localhost:3000

# Optional MTN MoMo collections configuration. Use production credentials and
# the matching target environment only after production access is configured.
MOMO_PRIMARY_KEY=
MOMOUSER_ID=
MOMOUSER_SECRET=
MOMO_TARGET_ENVIRONMENT=https://sandbox.momodeveloper.mtn.com
MOMO_ENV=sandbox
MOMO_CALLBACK_HOST=http://localhost:3000
MOMO_CURRENCY=EUR
MOMO_COUNTRY_CODE=256
MOMO_PHONE_PLACEHOLDER=0772 123 456

# Optional Safaricom Daraja (M-PESA STK Push) configuration.
# The callback URL must be publicly reachable over HTTPS.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-domain.example/billing/daraja/webhook
# Required to enable Daraja; set your KES-per-UGX rate (charges round up).
DARAJA_KES_PER_UGX=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_ACCOUNT_REFERENCE=Maxintel
DARAJA_PHONE_PLACEHOLDER=0712 345 678
